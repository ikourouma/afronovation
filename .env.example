# Afronovation rebuild - environment template
# Copy to app/.env.local and fill in real values. NEVER commit .env.local.
# Source of truth for where each value comes from: knowledgebase.md Section 7.

# --- Neon Postgres (console.neon.tech -> your project -> Connection Details) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Unpooled connection - preferred for drizzle-kit migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Neon Auth, managed Better Auth (Neon console -> Auth) ---
NEON_AUTH_BASE_URL="https://YOUR-NEON-AUTH-ENDPOINT"
# JWKS endpoint (reference/verification only, not a secret)
NEON_AUTH_JWKS_URL="https://YOUR-NEON-AUTH-ENDPOINT/.well-known/jwks.json"
# Session signing secret (self-hosted Better Auth + Drizzle adapter) - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="CHANGE_ME_32_HEX_CHARS_MIN"
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudflare R2 (dash.cloudflare.com -> R2 -> Manage R2 API Tokens) ---
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="afronovation-media"
# Broader Cloudflare API token, reserved for future programmatic bucket config (not the S3 client)
R2_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"
# Public base URL for images - r2.dev dev URL now, custom domain (e.g. media.afronovation.com)
# at Phase 6 DNS cutover. Leave unset to use the local media-staging/ fallback.
R2_PUBLIC_URL="https://pub-YOURHASH.r2.dev"

# --- Resend (resend.com -> API Keys; sender domain must be verified) ---
RESEND_API_KEY="re_YOUR_API_KEY"
CONTACT_FROM_EMAIL="Afronovation Website <website@afronovation.com>"
CONTACT_TO_EMAIL="hello@afronovation.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://afronovation.com"

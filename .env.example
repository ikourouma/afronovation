# Afronovation rebuild - environment template
# Copy to app/.env.local and fill in real values. NEVER commit .env.local.
# Source of truth for where each value comes from: knowledgebase.md Section 7.

# --- Neon Postgres (console.neon.tech -> your project -> Connection Details; use the pooled connection string) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Neon Auth, managed Better Auth (Neon console -> Auth) ---
NEON_AUTH_BASE_URL="https://YOUR-NEON-AUTH-ENDPOINT"
# Session signing secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="CHANGE_ME_32_HEX_CHARS_MIN"
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudflare R2 (dash.cloudflare.com -> R2 -> Manage R2 API Tokens) ---
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="afronovation-media"
# Public base URL for images (bucket public URL or custom domain, e.g. https://media.afronovation.com)
R2_PUBLIC_URL="https://pub-YOURHASH.r2.dev"

# --- Resend (resend.com -> API Keys; sender domain must be verified) ---
RESEND_API_KEY="re_YOUR_API_KEY"
CONTACT_FROM_EMAIL="Afronovation Website <website@afronovation.com>"
CONTACT_TO_EMAIL="hello@afronovation.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://afronovation.com"
